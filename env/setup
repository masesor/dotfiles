#!/usr/bin/env bash

set -e
set -o pipefail

script_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )"
export XDG_CONFIG_HOME="$HOME/.config"

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

# if i just did DEV_ENV=$(pwd) ./run then this is needed for the rest of the
# scripts
export DEV_ENV="$DEV_ENV"

filter=""
dry_run="0"

while [[ $# -gt 0 ]]; do
    echo "ARG: \"$1\""
    if [[ "$1" == "--dry" ]]; then
        dry_run="1"
    else
        filter="$1"
    fi
    shift
done

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

log "RUN: filter: $filter"

run_script() {
    local script="$1"

    if [[ -n "$filter" && "$script" != *"$filter"* ]]; then
        log "filter \"$filter\" excluded $script"
        return
    fi

    log "running script: $script"

    if [[ $dry_run == "0" ]]; then
        "$script"
    fi
}

linux_script="$script_dir/runs/linux"
if [[ "$(uname -s)" == "Linux" && -x "$linux_script" ]]; then
    run_script "$linux_script"
fi

while IFS= read -r script; do
    if [[ "$script" == "$linux_script" ]]; then
        continue
    fi
    run_script "$script"
done < <(find "$script_dir/runs" -mindepth 1 -maxdepth 1 -type f \
    \( -perm -u+x -o -perm -g+x -o -perm -o+x \) | sort)

echo "Setup complete! Restart your terminal or run 'exec zsh' to apply changes."
