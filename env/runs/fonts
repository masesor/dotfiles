#!/usr/bin/env bash

set -euo pipefail

# Install Powerline fonts for the Zsh Agnoster theme without modifying the
# current working directory or leaving a checkout behind.
fonts_dir="$(mktemp -d)"
trap 'rm -rf "$fonts_dir"' EXIT

git clone --depth=1 https://github.com/powerline/fonts.git "$fonts_dir"
"$fonts_dir/install.sh"
