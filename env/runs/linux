#!/usr/bin/env bash

set -euo pipefail

if [[ "$(uname -s)" != "Linux" ]]; then
  echo "Skipping Linux packages on $(uname -s)."
  exit 0
fi

if ! command -v apt-get >/dev/null 2>&1 || ! command -v dpkg >/dev/null 2>&1; then
  echo "This setup currently supports Debian-based Linux distributions only." >&2
  exit 1
fi

architecture="$(dpkg --print-architecture)"
case "$architecture" in
  amd64|arm64)
    ;;
  *)
    echo "Unsupported Debian architecture: $architecture" >&2
    exit 1
    ;;
esac

if [[ "$EUID" -eq 0 ]]; then
  apt_command=(apt-get)
else
  if ! command -v sudo >/dev/null 2>&1; then
    echo "sudo is required to install Linux packages." >&2
    exit 1
  fi
  apt_command=(sudo apt-get)
fi

echo "Installing Linux packages for $architecture..."
"${apt_command[@]}" update
"${apt_command[@]}" install -y \
  curl \
  fzf \
  gh \
  git-delta \
  markdownlint \
  neovim \
  ripgrep \
  tealdeer \
  tmux \
  xclip \
  zsh
